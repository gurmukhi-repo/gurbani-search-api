# /etc/systemd/system/gurbani-search-api.service
#
#   sudo cp deploy/systemd/gurbani-search-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gurbani-search-api
#
# Put the checkout in /opt/gurbani-search-api and the data in
# /opt/gurbani-search-api/data (npm run fetch-data).
[Unit]
Description=Gurbani search API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/gurbani-search-api
ExecStart=/usr/bin/node apps/web/server.js
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/gurbani-search-api.env
Environment=NODE_ENV=production
Environment=PORT=8080

# The process reads its data and serves it. It writes nothing and needs no
# privileges of any kind.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
